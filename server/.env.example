# Copy this file to `.env` (same folder) and adjust. Every value is optional on a laptop.

# Port the API listens on. Phones on the same Wi-Fi use http://<laptop-ip>:PORT
PORT=3000
HOST=0.0.0.0

# SQLite file (relative to the server/ folder). Delete it or run `npm run db:reset` to start over.
DATABASE_PATH=./data/kirimin.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# --- Hosting (see docs/HOSTING.md). Leave unset on a laptop. ---
# Turso database. When DATABASE_URL starts with libsql:// it replaces DATABASE_PATH.
#   turso db show kirimin --url        → DATABASE_URL
#   turso db tokens create kirimin     → DATABASE_AUTH_TOKEN
# DATABASE_URL=libsql://kirimin-<your-name>.turso.io
# DATABASE_AUTH_TOKEN=
# Cloudinary photos. When set, uploads go to Cloudinary instead of UPLOAD_DIR.
# Copy "API environment variable" from the Cloudinary console (Settings → API Keys).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=kirimin

# Signs login tokens. REQUIRED (long random string) when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me
TOKEN_TTL_DAYS=30

# Fill an empty database with demo users/trips (password: kirimin123)
SEED_ON_EMPTY=true

CORS_ORIGIN=*
LOG_REQUESTS=true
# NODE_ENV=production

# Local time zone (minutes from UTC) for recurring routes' weekdays. Bali/WITA = 480, Jakarta/WIB = 420.
TZ_OFFSET_MINUTES=480
# Recurring routes are published this many days ahead.
RECURRING_HORIZON_DAYS=2

# Expo push notifications. EXPO_ACCESS_TOKEN only if "enhanced push security" is enabled in Expo.
PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=

# No admin panel yet: approve KTP verification (X4) immediately. Set false to review manually.
AUTO_APPROVE_VERIFICATION=true
