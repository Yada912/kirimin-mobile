# Copy this file to `.env` (same folder) and adjust. Every value is optional on a laptop.

# Port the API listens on. Phones on the same Wi-Fi use http://<laptop-ip>:PORT
PORT=3000
HOST=0.0.0.0

# SQLite file (relative to the server/ folder). Delete it or run `npm run db:reset` to start over.
DATABASE_PATH=./data/kirimin.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# Signs login tokens. REQUIRED (long random string) when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me
TOKEN_TTL_DAYS=30

# Fill an empty database with demo users/trips (password: kirimin123)
SEED_ON_EMPTY=true

CORS_ORIGIN=*
LOG_REQUESTS=true
# NODE_ENV=production
