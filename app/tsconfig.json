{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@kirimin/shared": [
        "../shared/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "phosphor-react-native/src/icons/*": [
        "./node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "tests",
    "e2e"
  ]
}
